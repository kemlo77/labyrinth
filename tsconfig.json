{
    "compilerOptions": {
        "outDir": "./dist",
        "allowJs": true,
        "target": "esnext",
        "lib": [
            "esnext",
            "dom"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": [
            "vitest/globals"
        ],
        "skipLibCheck": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "verbatimModuleSyntax": true
    },
    "include": [
        "./src/**/*",
        "./tests/**/*",
        "./*.ts"
    ]
}